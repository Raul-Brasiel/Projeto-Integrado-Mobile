<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface"/>
            <corners android:topLeftRadius="0dp" android:bottomLeftRadius="0dp" android:topRightRadius="12dp" android:bottomRightRadius="12dp"/>
        </shape>
    </item>
    <item android:width="4dp" android:gravity="left">
        <shape android:shape="rectangle">
            <solid android:color="@color/late_red"/>
        </shape>
    </item>
</layer-list>
